# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.astro/
apps/web/dist/
coverage/
*.tsbuildinfo

# env & secrets — never commit
.env
.env.*
!.env.example

# raw third-party downloads (untrusted, possibly restricted)
data/imports/raw/

# private review material
research/reviews/private/

# OS / editor
.DS_Store
.vscode/
.idea/

# test artifacts
playwright-report/
test-results/

# generated by `pnpm research:export` (run by `pnpm build` locally and in CI) — not committed
data/exports/*.json
