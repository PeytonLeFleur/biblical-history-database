  "text_summary": {
    "layer": "text",
    "body": "On 13 Adar, when the enemies of the Jews hoped to overpower them, the Jews gathered in their cities and struck those who sought their harm; the officials helped them for fear of Mordecai. In Susa they killed 500 men and the ten sons of Haman; at Esther's request the king allowed a second day in Susa, when 300 more were killed, and Haman's sons were hanged. In the provinces 75,000 were killed; the Jews took no plunder. The provincial Jews rested and feasted on the 14th, those of Susa on the 15th.",
    "passage": "Esth.9.1-Esth.9.19"
  },
  "setting": {
    "period": "13–14 Adar of Xerxes year 12 (early 473 BC)",
    "body": "The date set by Haman's lot (3:7, 13). Josephus gives the same 75,000 for the provinces.",
