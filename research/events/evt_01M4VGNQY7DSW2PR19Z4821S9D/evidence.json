    {
      "id": "clm_01M4VGNQZ2VKEWX4ZC8V4G3B6S",
      "statement": "Haggai's first oracle (1/VI of Darius's second year) fell on 29 August 520 BC and the resumption of work (24/VI) on 21 September 520 BC.",
      "layer": "reconstruction",
      "passage": "Hag.1.1",
      "classification": "historically_plausible",
      "reasoning": "Parker and Dubberstein's table gives 1 Nisan of Darius year 2 as 3 April 520 and the sixth month beginning 29 August 520; adding 23 days gives 21 September. The conversion assumes that Haggai counts Darius's years and months by the Babylonian (Nisan) calendar, as is assumed for Ezra 6:15. Other conversions differ: Mitchell (1912) gives about the middle of August, Guzik September; the Parker and Dubberstein table (1942 edition used here) is later than Mitchell and is preferred, but the claim stays historically plausible.",
      "supporting_evidence": [
        "evd_01M4VGNQZ29VNBHQW89TG0N85E"
      ],
      "counterevidence": [
        "evd_01M4VJCXAEGHVS6EGWBTP1BDT5",
        "evd_01M4VJCXAEW1S8MGQ9T27AEB0Q"
      ],
      "contextual_evidence": [],
      "limitations": [
        "Later months of year 2 are not legible in the OCR used, so Hag 2:1, 10, 20 and Zech 1:1 are given only by month."
      ],
      "reviewer_status": "machine_proposed",
      "review_required": false,
      "research_date": "2026-10-13"
