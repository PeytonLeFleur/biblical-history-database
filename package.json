{
  "name": "biblical-history-database",
  "private": true,
  "description": "Biblical History Atlas — source-verified biblical history research database and website.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @atlas/web build",
    "dev:web": "pnpm --filter @atlas/web dev",
    "dev:api": "pnpm --filter @atlas/api dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @atlas/database generate",
    "db:migrate": "pnpm --filter @atlas/database migrate",
    "db:seed": "pnpm --filter @atlas/database seed",
    "scripture:import": "tsx scripts/import-web.ts",
    "research:status": "tsx scripts/cli.ts research status",
    "research:book": "tsx scripts/cli.ts research book",
    "research:chapter": "tsx scripts/cli.ts research chapter",
    "research:event": "tsx scripts/cli.ts research event",
    "research:resume": "tsx scripts/cli.ts research resume",
    "research:validate": "tsx scripts/cli.ts research validate",
    "research:crossrefs": "tsx scripts/cli.ts research crossrefs",
    "research:refresh": "tsx scripts/cli.ts research refresh",
    "research:export": "tsx scripts/cli.ts research export",
    "chronology:validate": "tsx scripts/cli.ts chronology validate",
    "chronology:recalculate": "tsx scripts/cli.ts chronology recalculate",
    "chronology:anchors": "tsx scripts/cli.ts chronology anchors",
    "chronology:models": "tsx scripts/cli.ts chronology models",
    "review:list": "tsx scripts/cli.ts review list",
    "review:show": "tsx scripts/cli.ts review show",
    "review:approve": "tsx scripts/cli.ts review approve",
    "review:reject": "tsx scripts/cli.ts review reject",
    "review:return": "tsx scripts/cli.ts review return"
  },
  "devDependencies": {
    "@atlas/database": "workspace:*",
    "@atlas/scripture": "workspace:*",
    "@atlas/shared": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
