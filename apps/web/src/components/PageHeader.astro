---
interface Props { eyebrow?: string; title: string }
const { eyebrow, title } = Astro.props;
---
<header class="mb-8">
  {eyebrow && <p class="text-xs uppercase tracking-widest text-brass-dark">{eyebrow}</p>}
  <h1 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl">{title}</h1>
  <div class="mt-3 max-w-3xl text-stone"><slot /></div>
</header>
