---
import Base from '../layouts/Base.astro';
import { CANON } from '@atlas/scripture';
const groups = [
  { label: 'Old Testament', books: CANON.filter((b) => b.testament === 'OT') },
  { label: 'New Testament', books: CANON.filter((b) => b.testament === 'NT') },
];
---
<Base title="Books of the Bible">
  <h1 class="font-serif text-4xl">The 66 books</h1>
  <p class="mt-3 text-stone">Protestant canon, standard English order. Research for each book has not started yet.</p>
  {groups.map((g) => (
    <section class="mt-10" aria-label={g.label}>
      <h2 class="border-b border-stone/30 pb-2 font-serif text-2xl">{g.label}</h2>
      <ol class="mt-4 grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-2 md:grid-cols-3">
        {g.books.map((b) => (
          <li class="flex justify-between border-b border-parchment py-1.5">
            <span>{b.name}</span>
            <span class="text-sm tabular-nums text-stone">{b.chapters} ch.</span>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
