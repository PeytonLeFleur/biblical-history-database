---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EmptyState from '../components/EmptyState.astro';
---
<Base title="Artifact explorer">
  <PageHeader eyebrow="Evidence" title="Artifact explorer">Inscriptions, seals, tablets and other objects connected to biblical history.</PageHeader>
  <EmptyState title="No artifact records yet">
    The database supports artifacts with separate findspots and current holding institutions. No artifact has been researched and
    verified yet. Images will be shown only when they are public-domain or CC0. Otherwise the record links to the holding institution.
  </EmptyState>
</Base>
