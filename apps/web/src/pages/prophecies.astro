---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Badge from '../components/Badge.astro';
import ReviewerBadge from '../components/ReviewerBadge.astro';
import EmptyState from '../components/EmptyState.astro';
import { APPROACH_LABEL, data, entitiesOf, entityById, passageLabel, passageUrl, sourceById, titleCase, url } from '../lib/data';
const prophecies = entitiesOf('prophecy');
const visions = entitiesOf('vision');
const reviews = new Map(data().reviews.map((r) => [r.record_id, r]));
const researchedPassages = new Set([...prophecies.map((p) => p.passage), ...visions.map((v) => v.passage)]);
const extracted = data().extraction.flatMap((x) => x.candidates.filter((c) => (c.record_type === 'prophecy' || c.record_type === 'vision') && !researchedPassages.has(c.passage)));
const eventFor = (id: string | null) => (id ? data().events.find((b) => b.event.id === id) : undefined);
---
<Base title="Prophecy explorer">
  <PageHeader eyebrow="Prophecy" title="Prophecy explorer">
    Visions and prophetic passages with the identifications the text itself makes, and the major interpretations. Each interpretation is
    labelled by approach (preterist, futurist, historicist, idealist or mixed) and attributed to its proponents. Proposed fulfillments await
    owner review and are not presented as established history.
  </PageHeader>

  <section aria-labelledby="researched">
    <h2 id="researched" class="font-serif text-2xl">Researched prophetic records</h2>
    {prophecies.length === 0 && <div class="mt-4"><EmptyState title="None yet">No prophecy has completed research.</EmptyState></div>}
    <ul class="mt-4 space-y-10">
      {prophecies.map((p) => {
        const v = p.vision_id ? entityById(p.vision_id) : undefined;
        const ev = v && v.kind === 'vision' ? eventFor(v.experience_event_id) : undefined;
        return (
          <li id={p.id} class="border-t border-stone-light/30 pt-4" data-testid="prophecy-record">
            <h3 class="font-serif text-xl">{p.title}</h3>
            <p class="text-sm text-stone"><a href={passageUrl(p.passage)}>{passageLabel(p.passage)}</a>{ev && <> · <a href={url(`events/${ev.event.slug}/#vision`)}>{ev.event.title}</a></>}</p>
            <p class="mt-2">{p.description}</p>
            {p.in_text_interpretation && <p class="mt-1 text-sm"><span class="font-semibold">Identified in the text:</span> {p.in_text_interpretation}</p>}
            <ul class="mt-3 space-y-3">
              {p.interpretations.map((i) => (
                <li class="border-l-2 border-brass/60 pl-3 text-sm">
                  <p class="font-semibold">{i.label}</p>
                  <p class="flex flex-wrap items-center gap-1.5 text-xs text-stone">
                    <Badge tone="outline">{APPROACH_LABEL[i.approach]}</Badge>{i.framework && <Badge tone="outline">{i.framework}</Badge>}
                    {i.is_proposed_fulfillment && <ReviewerBadge status={i.reviewer_status} />}
                    {reviews.get(i.id)?.status === 'open' && <Badge tone="brass">In owner review queue</Badge>}
                  </p>
                  <p class="mt-1">{i.summary}</p>
                  <p class="text-xs text-stone">Proponents: {i.proponents.join('; ')}{i.citations.length > 0 && <> · Sources: {i.citations.map((c) => sourceById(c)).filter(Boolean).map((s, k) => <>{k > 0 && '; '}<a href={url(`sources/#${s!.id}`)}>{s!.title}</a></>)}</>}</p>
                </li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="extracted">
    <h2 id="extracted" class="font-serif text-2xl">Extracted prophetic passages not yet researched</h2>
    <p class="mt-1 text-sm text-stone">These are extraction records only (Rule 01).</p>
    {extracted.length === 0 ? <p class="mt-3 text-sm text-stone">None.</p> : (
      <ul class="mt-4 space-y-3">
        {extracted.map((c) => (
          <li class="text-sm"><a href={passageUrl(c.passage)}>{passageLabel(c.passage)}</a> — <strong>{c.title}</strong> <Badge tone="outline">{titleCase(c.literary_classification)}</Badge></li>
        ))}
      </ul>
    )}
  </section>
</Base>
