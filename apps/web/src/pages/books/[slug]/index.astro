---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { CANON, data, eventsTouchingChapter, extractionFor, url, versesPerChapter } from '../../../lib/data';
import type { CanonBook } from '@atlas/scripture';

export function getStaticPaths() {
  return CANON.map((b) => ({ params: { slug: b.slug }, props: { book: b } }));
}
const { book } = Astro.props as { book: CanonBook };
const verses = versesPerChapter(book.osis);
const total = verses.reduce((a, n) => a + n, 0);
const chapters = verses.map((n, i) => {
  const x = extractionFor(book.osis, i + 1);
  return { n: i + 1, verses: n, status: x?.status ?? null, reviewed: x ? x.verse_coverage.filter((v) => v.status !== 'not_reviewed').length : 0, candidates: x?.candidates.length ?? 0 };
});
const reviewed = chapters.reduce((a, c) => a + c.reviewed, 0);
const events = data().events.filter((b) => b.event.mentions.some((m) => m.passage.startsWith(`${book.osis}.`)));
---
<Base title={book.name}>
  <nav aria-label="Breadcrumb" class="text-sm text-stone"><a href={url('books/')}>Bible</a> / {book.name}</nav>
  <PageHeader eyebrow={book.testament === 'OT' ? 'Old Testament' : 'New Testament'} title={book.name}>
    {book.chapters} chapters · {total.toLocaleString('en-US')} verses · {reviewed.toLocaleString('en-US')} verses reviewed for historical content
    ({chapters.filter((c) => c.status === 'complete').length} of {book.chapters} chapters extracted).
  </PageHeader>

  <section aria-labelledby="chapters">
    <h2 id="chapters" class="font-serif text-2xl">Chapters</h2>
    <ol class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-8 md:grid-cols-10">
      {chapters.map((c) => (
        <li>
          <a href={url(`books/${book.slug}/${c.n}/`)} class={`block border px-2 py-2 text-center no-underline ${c.status === 'complete' ? 'border-olive bg-olive text-ivory' : c.status ? 'border-brass' : 'border-stone-light/40'}`}
            title={c.status === 'complete' ? `Extracted: ${c.candidates} candidates` : c.status ? 'Extraction in progress' : 'Not yet reviewed'}>
            {c.n}<span class="sr-only">{c.status === 'complete' ? ' (extracted)' : c.status ? ' (in progress)' : ' (not reviewed)'}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="mt-3 text-xs text-stone">Filled: chapter extraction complete · Outlined in brass: in progress · Plain: not yet reviewed.</p>
  </section>

  <section aria-labelledby="events" class="mt-12">
    <h2 id="events" class="font-serif text-2xl">Researched events in {book.name}</h2>
    {events.length === 0 ? (
      <div class="mt-4"><EmptyState title="No published event research for this book yet">The book is indexed and its text is browsable. Historical research proceeds chapter by chapter under the project's rules.</EmptyState></div>
    ) : (
      <ul class="mt-4 list-disc pl-5">{events.map((b) => <li><a href={url(`events/${b.event.slug}/`)}>{b.event.title}</a></li>)}</ul>
    )}
  </section>
</Base>
