---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import { entitiesOf, unresearchedLabels, url } from '../../lib/data';
const kingdoms = entitiesOf('kingdom');
const pending = unresearchedLabels(['Egypt', 'Assyria', 'Babylon', 'Media and Persia (Achaemenid Empire)', 'Macedonian and Greek kingdoms', 'Seleucid Empire', 'Ptolemaic Kingdom', 'Hasmonean dynasty', 'Herodian dynasty', 'Roman Empire']);
---
<Base title="Kingdoms and civilizations">
  <PageHeader eyebrow="Directory" title="Kingdoms and civilizations">Kingdoms recorded in published research, with their rulers per chronology model.</PageHeader>
  <ul class="divide-y divide-parchment">
    {kingdoms.map((k) => <li class="py-3"><a class="font-serif text-lg" href={url(`kingdoms/${k.slug}/`)}>{k.name}</a><p class="text-sm text-stone">{k.description}</p></li>)}
  </ul>
  {pending.length > 0 && <div class="mt-10">
    <EmptyState title="Not yet researched">Ruler chronologies for {pending.join(', ')} have not been seeded. SPEC 12.7 requires them to come from verified scholarly sources, with competing models preserved.</EmptyState>
  </div>}
</Base>
