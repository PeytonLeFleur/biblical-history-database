---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import { PUBLICATION_LABEL, data, passageLabel, url } from '../lib/data';
const { events, coverage, sources, reviews } = data();
const reviewed = coverage.reduce((a, c) => a + c.verses_reviewed, 0);
const total = coverage.reduce((a, c) => a + c.verses, 0);
const open = reviews.filter((r) => r.status === 'open').length;
---
<Base title="Biblical History Atlas">
  <p class="text-xs uppercase tracking-widest text-brass-dark">Research collection · Early stage</p>
  <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">Scripture in its historical world</h1>
  <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed">
    A research atlas connecting the 66 books of the Protestant Bible with ancient documents, archaeology, scientific study, chronology
    and geography. Every claim is traced to its source, and every uncertainty stays visible.
  </p>
  <form action={url('search/')} method="get" role="search" class="mt-8 flex max-w-xl gap-2">
    <label for="home-q" class="sr-only">Search</label>
    <input id="home-q" name="q" type="search" placeholder="Search a passage, person, place or event" class="min-w-0 flex-1 border border-stone-light bg-ivory px-3 py-2" />
    <button class="bg-olive px-4 py-2 text-ivory">Search</button>
  </form>

  <section class="mt-14 rule pt-8" aria-labelledby="featured">
    <h2 id="featured" class="font-serif text-2xl">Published research</h2>
    <ul class="mt-4 space-y-5">
      {events.map(({ event: e }) => (
        <li>
          <a class="font-serif text-xl" href={url(`events/${e.slug}/`)}>{e.title}</a>
          <p class="text-sm text-stone">{e.mentions.map((m) => passageLabel(m.passage)).join(' · ')}</p>
          <p class="mt-1">{e.summary}</p>
          <div class="mt-1"><Badge>{PUBLICATION_LABEL[e.publication_level]}</Badge></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14 rule pt-8" aria-labelledby="status">
    <h2 id="status" class="font-serif text-2xl">Where the research stands</h2>
    <p class="mt-3 max-w-2xl text-stone">
      {reviewed.toLocaleString('en-US')} of {total.toLocaleString('en-US')} verses reviewed · {events.length} published event dossier{events.length === 1 ? '' : 's'} ·
      {sources.length} registered sources · {open} item{open === 1 ? '' : 's'} awaiting owner review. The project is at an early stage. See
      <a href={url('progress/')}>research progress</a>.
    </p>
  </section>

  <section class="mt-14 rule pt-8" aria-labelledby="distinctions">
    <h2 id="distinctions" class="font-serif text-2xl">Four kinds of knowledge, kept distinct</h2>
    <dl class="mt-6 grid gap-6 sm:grid-cols-2">
      <div><dt class="font-semibold text-olive">Biblical text</dt><dd class="mt-1 text-stone">What Scripture explicitly records.</dd></div>
      <div><dt class="font-semibold text-olive">Biblical interpretation</dt><dd class="mt-1 text-stone">What commentators and theological traditions conclude.</dd></div>
      <div><dt class="font-semibold text-olive">Historical reconstruction</dt><dd class="mt-1 text-stone">What scholars infer about ancient circumstances and chronology.</dd></div>
      <div><dt class="font-semibold text-olive">External evidence</dt><dd class="mt-1 text-stone">What independent documents, archaeology, and science establish.</dd></div>
    </dl>
  </section>

  <section class="mt-14 rule pt-8" aria-labelledby="explore">
    <h2 id="explore" class="font-serif text-2xl">Explore</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {[['books/', 'Bible explorer', 'All 66 books with research coverage'], ['timeline/', 'Timeline', 'Computed chronology with uncertainty'], ['map/', 'Map', 'Sourced locations and their confidence'], ['sources/', 'Sources', 'Bibliography with verification levels'], ['crossrefs/', 'Cross-references', 'Typed connections between passages'], ['methodology/', 'Methodology', 'How research is done and labelled']].map(([h, t, d]) => (
        <li class="border-t border-stone-light/40 pt-2"><a class="font-semibold" href={url(h!)}>{t}</a><p class="text-sm text-stone">{d}</p></li>
      ))}
    </ul>
  </section>
</Base>
