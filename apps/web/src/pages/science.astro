---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ClassificationBadge from '../components/ClassificationBadge.astro';
import VerificationBadge from '../components/VerificationBadge.astro';
import EmptyState from '../components/EmptyState.astro';
import { data, sourceById, url } from '../lib/data';
const papers = data().sources.filter((s) => s.source_type === 'scientific_paper' || s.source_type === 'dataset');
const uses = (id: string) => data().events.flatMap((b) => (b.evidence?.evidence ?? []).filter((e) => e.source_id === id).map((e) => ({ e, b })));
---
<Base title="Scientific research">
  <PageHeader eyebrow="Evidence" title="Scientific research">
    Peer-reviewed papers and datasets registered in the source registry, with how each was used. Several were read only as abstracts, and that is stated on each.
  </PageHeader>
  {papers.length === 0 ? <EmptyState title="No scientific sources yet">They appear when cited by research.</EmptyState> : (
    <ul class="space-y-8">
      {papers.map((s) => (
        <li class="border-t border-stone-light/30 pt-4 text-sm" id={s.id}>
          <p class="font-serif text-base"><em>{s.title}</em></p>
          <p class="text-stone">{s.authors.join(', ')} · {s.journal} · {s.published_date}</p>
          <p class="mt-1 flex flex-wrap items-center gap-1.5"><VerificationBadge level={s.verification_level} />{s.doi && <a href={`https://doi.org/${s.doi}`}>doi:{s.doi}</a>}</p>
          {s.access_notes && <p class="mt-1">{s.access_notes}</p>}
          {uses(s.id).length === 0 ? <p class="mt-1 text-stone">Registered but not used as direct evidence.</p> : uses(s.id).map(({ e, b }) => (
            <div class="mt-2 border-l-2 border-parchment pl-3">
              <p>{e.finding}</p>
              {e.claim_ids.map((cid) => { const c = b.evidence?.claims.find((x) => x.id === cid); return c && <p class="mt-1">Bears on <a href={url(`events/${b.event.slug}/#${c.id}`)}>“{c.statement}”</a> <ClassificationBadge value={c.classification} /></p>; })}
            </div>
          ))}
        </li>
      ))}
    </ul>
  )}
</Base>
